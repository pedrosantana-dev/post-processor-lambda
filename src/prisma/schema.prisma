//Prisma schema for pora-post-processor
// AWS Lambda function that processes scheduled social media posts from SQS
// NOTE: This file was reconstructed based on package.json (Prisma client,
// SQS consumer, YouTube/Instagram/Facebook keywords) and pipeline.yaml
// (binaryTargets patched for Lambda's rhel-openssl-3.0.x runtime).
// It is a best-effort inference, not a recovery of the original file —
// please review model/field names against your actual index.js.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SocialPlatform {
  YOUTUBE
  INSTAGRAM
  FACEBOOK
}

enum PostStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  socialAccounts SocialAccount[]
  scheduledPosts ScheduledPost[]
}

model SocialAccount {
  id            String          @id @default(uuid())
  userId        String
  platform      SocialPlatform
  externalId    String          // account/channel/page id on the platform
  accessToken   String
  refreshToken  String?
  tokenExpiresAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledPosts ScheduledPost[]

  @@unique([platform, externalId])
  @@index([userId])
}

model ScheduledPost {
  id              String         @id @default(uuid())
  userId          String
  socialAccountId String
  platform        SocialPlatform
  content         String
  mediaUrl        String?
  scheduledFor    DateTime
  status          PostStatus     @default(PENDING)
  sqsMessageId    String?        @unique
  publishedAt     DateTime?
  externalPostId  String?        // id returned by the platform after publishing
  errorMessage    String?
  retryCount      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId])
}
